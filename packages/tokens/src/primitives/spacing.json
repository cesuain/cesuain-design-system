{
  "spacing": {
    "$type": "dimension",
    "$description": "4px base scale. Step names match Tailwind's spacing multipliers (step × 0.25rem).",
    "0": { "$value": { "value": 0, "unit": "rem" } },
    "0-5": { "$value": { "value": 0.125, "unit": "rem" } },
    "1": { "$value": { "value": 0.25, "unit": "rem" } },
    "1-5": { "$value": { "value": 0.375, "unit": "rem" } },
    "2": { "$value": { "value": 0.5, "unit": "rem" } },
    "2-5": { "$value": { "value": 0.625, "unit": "rem" } },
    "3": { "$value": { "value": 0.75, "unit": "rem" } },
    "4": { "$value": { "value": 1, "unit": "rem" } },
    "5": { "$value": { "value": 1.25, "unit": "rem" } },
    "6": { "$value": { "value": 1.5, "unit": "rem" } },
    "7": { "$value": { "value": 1.75, "unit": "rem" } },
    "8": { "$value": { "value": 2, "unit": "rem" } },
    "9": { "$value": { "value": 2.25, "unit": "rem" } },
    "10": { "$value": { "value": 2.5, "unit": "rem" } },
    "11": { "$value": { "value": 2.75, "unit": "rem" } },
    "12": { "$value": { "value": 3, "unit": "rem" } },
    "13": { "$value": { "value": 3.25, "unit": "rem" } },
    "16": { "$value": { "value": 4, "unit": "rem" } },
    "20": { "$value": { "value": 5, "unit": "rem" } },
    "24": { "$value": { "value": 6, "unit": "rem" } },
    "32": { "$value": { "value": 8, "unit": "rem" } }
  },
  "size": {
    "$type": "dimension",
    "container": {
      "$description": "Maximum widths for page containers.",
      "sm": { "$value": { "value": 40, "unit": "rem" } },
      "md": { "$value": { "value": 48, "unit": "rem" } },
      "lg": { "$value": { "value": 64, "unit": "rem" } },
      "xl": { "$value": { "value": 80, "unit": "rem" } }
    },
    "content": {
      "$description": "Maximum line lengths for readable text.",
      "prose": { "$value": { "value": 42, "unit": "rem" } },
      "narrow": { "$value": { "value": 48, "unit": "rem" } }
    },
    "icon": {
      "xs": { "$value": { "value": 12, "unit": "px" } },
      "sm": { "$value": { "value": 14, "unit": "px" } },
      "md": { "$value": { "value": 16, "unit": "px" } },
      "lg": { "$value": { "value": 20, "unit": "px" } },
      "xl": { "$value": { "value": 24, "unit": "px" } }
    }
  },
  "breakpoint": {
    "$type": "dimension",
    "sm": { "$value": { "value": 40, "unit": "rem" } },
    "md": { "$value": { "value": 48, "unit": "rem" } },
    "lg": { "$value": { "value": 64, "unit": "rem" } },
    "xl": { "$value": { "value": 80, "unit": "rem" } },
    "2xl": { "$value": { "value": 96, "unit": "rem" } }
  }
}
